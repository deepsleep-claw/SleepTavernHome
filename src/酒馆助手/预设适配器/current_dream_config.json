{
  "title": "梦鲸思客设置",
  "script_button_name": "梦鲸思客设置",
  "summary": {
    "generation": {
      "group_id": "输出模式",
      "option_id": "大总结模式",
      "detect_regexes": [
        "# 梦鲸思客大总结",
        "/^剧情总结\\n/m"
      ]
    },
    "settings": {
      "content_handling": "direct",
      "filter_html_code_blocks": true,
      "manual_prompt_enabled": false,
      "hide_rules": {
        "hide_first": false,
        "hide_user": true,
        "hide_assistant_system": true,
        "hide_summary": false,
        "auto_hide_after_manual": true
      }
    }
  },
  "groups": [
