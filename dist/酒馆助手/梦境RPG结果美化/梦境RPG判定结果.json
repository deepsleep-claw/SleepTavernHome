  "id": "0ff81105-cc26-4c8e-9726-b207679df465",
  "scriptName": "[RPG美化]AI判定结果",
  "findRegex": "/<rpg_check\\b(?:\"[^\"]*\"|'[^']*'|[^'\">/])*(?:\\/\\s*>|>\\s*([\\s\\S]*?)\\s*<\\/rpg_check\\s*>)/gi",
  "trimStrings": [],
  "placement": [
    2
  ],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": null,
  "replaceString": "<style>\n.drpg-result {\n  --drpg-grade-color: var(--drpg-muted, #746a57);\n  display: flex;\n  box-sizing: border-box;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.15em;\n  width: 100%;\n  max-width: 100%;\n  margin: 0.35em 0 0.45em;\n  padding: 0.3em 0.7em;\n  border: 0;\n  border-left: 2px solid var(--drpg-grade-color);\n  border-radius: 0;\n  background: linear-gradient(\n    90deg,\n    color-mix(in srgb, var(--drpg-grade-color) 18%, transparent) 0%,\n    color-mix(in srgb, var(--drpg-grade-color) 7%, transparent) 58%,\n    transparent 100%\n  );\n  color: var(--drpg-ink, #29271e);\n  font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;\n  font-size: 1em;\n  line-height: 1.45;\n  overflow-wrap: anywhere;\n}\n.drpg-result [hidden] {\n  display: none !important;\n}\n.drpg-result + br,\n.drpg-result[data-mode='secret'] .drpg-result-icon {\n  display: none;\n}\n.drpg-result[data-drpg-complete]:has(.drpg-result-content:empty):has(.drpg-result-meta[hidden]) {\n  display: none;\n}\n.drpg-result[data-grade='critical'] {\n  --drpg-grade-color: var(--drpg-check-critical, #198f4c);\n}\n.drpg-result[data-grade='extreme'] {\n  --drpg-grade-color: var(--drpg-check-extreme, #23734f);\n}\n.drpg-result[data-grade='hard'] {\n  --drpg-grade-color: var(--drpg-check-hard, #6a842b);\n}\n.drpg-result[data-grade='regular'] {\n  --drpg-grade-color: var(--drpg-check-regular, #8a7b2a);\n}\n.drpg-result[data-grade='failure'] {\n  --drpg-grade-color: var(--drpg-check-failure, #bd4b43);\n}\n.drpg-result[data-grade='fumble'] {\n  --drpg-grade-color: var(--drpg-check-fumble, #7f2938);\n}\n.drpg-result .drpg-result-content {\n  display: block;\n  max-width: 100%;\n  font-size: 1.05em;\n  font-weight: 600;\n  white-space: normal;\n}\n.drpg-result .drpg-result-content:empty {\n  display: none;\n}\n.drpg-result .drpg-result-meta {\n  display: inline-flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.3em;\n  max-width: 100%;\n  color: var(--drpg-grade-color);\n  font-size: 0.95em;\n  line-height: 1.35;\n}\n.drpg-result .drpg-result-numbers {\n  font-variant-numeric: tabular-nums;\n}\n.drpg-result:not([data-drpg-complete]) {\n  height: 3.9em;\n  min-width: 0;\n  overflow: hidden;\n}\n.drpg-result:not([data-drpg-complete]) .drpg-result-content,\n.drpg-result:not([data-drpg-complete]) .drpg-result-meta {\n  display: block;\n  width: 100%;\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n.drpg-result:not([data-drpg-complete]) .drpg-result-icon,\n.drpg-result:not([data-drpg-complete]) .drpg-grade {\n  margin-inline-end: 0.3em;\n}\n.drpg-result .drpg-secret-reveal {\n  margin: 0;\n  padding: 0.02em 0.45em;\n  border: 1px solid var(--drpg-soft-line, #cfbfa2);\n  border-radius: 4px;\n  background: repeating-linear-gradient(135deg, transparent 0 3px, #80808016 3px 6px), var(--drpg-soft, #ece2ce);\n  color: var(--drpg-muted, #746a57);\n  font: inherit;\n  line-height: 1.35;\n  letter-spacing: 0.01em;\n  cursor: pointer;\n}\n.drpg-result .drpg-secret-reveal:hover {\n  border-color: var(--drpg-line, #b99c67);\n  color: var(--drpg-ink, #29271e);\n}\n.drpg-result .drpg-secret-reveal:focus-visible {\n  outline: 2px solid var(--drpg-line, #b99c67);\n  outline-offset: 2px;\n}\n</style>\n<span class=\"drpg-result\" data-drpg-check><span class=\"drpg-result-content\">$1</span><span class=\"drpg-result-meta\" aria-live=\"polite\" hidden><span class=\"drpg-result-icon\" aria-hidden=\"true\">◇</span><span class=\"drpg-grade\"></span><span class=\"drpg-result-numbers\" hidden></span><button class=\"drpg-secret-reveal\" type=\"button\" aria-label=\"点击显示暗骰结果\" hidden>[暗骰结果]</button></span></span>"
}
