  "replaceString": "<style>\n.drpg-action {\n  --answer-paper: var(--drpg-answer-paper, var(--drpg-paper, #fff8ed));\n  --answer-ink: var(--drpg-answer-ink, var(--drpg-ink, #432710));\n  --answer-question: var(--drpg-answer-question, var(--drpg-ink, #573511));\n  --answer-border: var(--drpg-answer-border, var(--drpg-line, #a76c2f));\n  --answer-accent: var(--drpg-answer-accent, #c57934);\n  --answer-fill: var(--drpg-answer-fill, var(--drpg-soft, #f3debf));\n  display: flex;\n  box-sizing: border-box;\n  flex-direction: column;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  margin: 0.5em 0 0.6em;\n  padding: 0.55em 0.7em 0.65em;\n  border: 1px solid var(--answer-border);\n  border-radius: 10px;\n  background:\n    linear-gradient(115deg, color-mix(in srgb, var(--answer-fill) 12%, transparent), transparent 65%),\n    var(--answer-paper);\n  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--answer-question) 14%, transparent);\n  color: var(--answer-ink);\n  font-family: inherit;\n  font-size: 1em;\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n.drpg-action [hidden] {\n  display: none !important;\n}\n.drpg-action + br {\n  display: none;\n}\n.drpg-action .drpg-action-head {\n  display: flex;\n  align-items: center;\n  gap: 0.45em;\n  min-width: 0;\n  padding: 0 0.1em 0.35em;\n  border-bottom: 1px solid color-mix(in srgb, var(--answer-border) 65%, transparent);\n}\n.drpg-action .drpg-action-emblem {\n  flex: 0 0 auto;\n  color: var(--answer-question);\n  font-size: 1.3em;\n  line-height: 1;\n}\n.drpg-action .drpg-action-title {\n  flex: 0 0 auto;\n  font-family: KaiTi, STKaiti, 'Kaiti SC', 'Noto Serif SC', serif;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  white-space: nowrap;\n}\n.drpg-action .drpg-action-tag {\n  flex: 0 0 auto;\n  margin-left: auto;\n  padding-left: 0.6em;\n  color: var(--answer-question);\n  font-family: Georgia, 'Times New Roman', serif;\n  font-size: 0.68em;\n  letter-spacing: 0.12em;\n  line-height: 1.3;\n  white-space: nowrap;\n}\n.drpg-action .drpg-action-question {\n  display: block;\n  box-sizing: border-box;\n  min-width: 0;\n  margin: 0;\n  padding: 0.42em 0.2em 0.48em;\n  border-bottom: 1px solid color-mix(in srgb, var(--answer-border) 80%, transparent);\n  color: var(--answer-question);\n  font-family: KaiTi, STKaiti, 'Kaiti SC', 'Noto Serif SC', serif;\n  font-size: 1.18em;\n  font-weight: 400;\n  font-synthesis: none;\n  line-height: 1.5;\n  letter-spacing: 0.025em;\n  white-space: pre-wrap;\n  quotes: '「' '」' '『' '』';\n}\n.drpg-action .drpg-action-line {\n  position: relative;\n  display: flex;\n  box-sizing: border-box;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 0.3em 0.65em;\n  min-width: 0;\n  margin-top: 0.5em;\n  padding: 0.4em 0.65em 0.42em 1.6em;\n  border-radius: 7px;\n  background: linear-gradient(\n    90deg,\n    color-mix(in srgb, var(--answer-fill) 78%, transparent),\n    color-mix(in srgb, var(--answer-fill) 40%, transparent)\n  );\n}\n.drpg-action .drpg-action-line::before {\n  content: '';\n  position: absolute;\n  top: 0.4em;\n  bottom: 0.4em;\n  left: 0.6em;\n  width: 3px;\n  border-radius: 2px;\n  background: var(--answer-accent);\n}\n.drpg-action .drpg-action-content {\n  flex: 1 1 10em;\n  min-width: 0;\n  font-family: inherit;\n  font-size: 1.02em;\n  font-weight: 400;\n  line-height: 1.5;\n  white-space: pre-wrap;\n}\n.drpg-action .drpg-action-value {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  margin-left: auto;\n  padding: 0.02em 0.48em;\n  border: 1px solid var(--drpg-difficulty-color, var(--answer-border));\n  border-radius: 5px;\n  background: color-mix(in srgb, var(--answer-paper) 55%, transparent);\n  color: var(--drpg-difficulty-color, var(--answer-ink));\n  font: inherit;\n  font-size: 0.86em;\n  line-height: 1.45;\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n}\n.drpg-action .drpg-action-outcome {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  column-gap: 0.8em;\n  row-gap: 0.15em;\n  margin-top: 0.4em;\n  padding-inline: 0.65em;\n  font-size: 0.86em;\n  font-variant-numeric: tabular-nums;\n  font-weight: 600;\n}\n.drpg-action .drpg-action-outcome > span {\n  color: var(--drpg-outcome-color, var(--answer-ink));\n}\n@media (max-width: 380px) {\n  .drpg-action {\n    padding: 0.5em;\n  }\n  .drpg-action .drpg-action-tag {\n    font-size: 0.61em;\n    letter-spacing: 0.08em;\n  }\n}\n</style>\n<span class=\"drpg-action\" data-drpg-answer role=\"group\" aria-label=\"梦客应答\"><span class=\"drpg-action-head\"><span class=\"drpg-action-emblem\" aria-hidden=\"true\">✦</span><span class=\"drpg-action-title\">梦客应答</span><span class=\"drpg-action-tag\" aria-hidden=\"true\">DREAM ANSWER</span></span><q class=\"drpg-action-question\" hidden></q><span class=\"drpg-action-line\"><span class=\"drpg-action-content\">$1</span><span class=\"drpg-action-value\" hidden></span></span><span class=\"drpg-action-outcome\" aria-live=\"polite\" hidden></span></span>"
}
